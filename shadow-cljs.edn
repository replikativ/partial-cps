;; shadow-cljs configuration
{:source-paths
 ["src"
  "test"]

 :dependencies
 [[org.clojure/clojure "1.12.0"]
  [riddley/riddley "0.2.0"]]

 :builds
 {:test
  {:target :node-script
   :output-to "target/test.js"
   :main is.simm.partial-cps.async-test/run-tests
   :autorun true}
   
  ;; CI build, compiled by the replikativ/clj-tools orb's tools/build
  ;; (`npx shadow-cljs compile ci`) and run by tools/cljstest via
  ;; bin/run-cljstests (`shadow-cljs release ci && node out/ci-tests.js`).
  :ci
  {:target :node-test
   :output-to "out/ci-tests.js"
   :ns-regexp "-test$"
   :compiler-options {:elide-asserts false}}

  :browser-test
  {:target :browser-test
   :test-dir "target/browser-test"
   :devtools {:http-port 8021
              :http-root "target/browser-test"}}
  
  :node-repl
  {:target :node-script
   :output-to "target/node-repl.js"
   :main is.simm.partial-cps.sequence-test/init}}}
